# Evidentia Configuration
# Copy this file to .env and fill in your values

# ─── Server ───
EVIDENTIA_HOST=0.0.0.0
EVIDENTIA_PORT=8000
EVIDENTIA_ENV=development
EVIDENTIA_DEBUG=true
EVIDENTIA_LOG_LEVEL=INFO

# ─── Database ───
DATABASE_URL=postgresql+asyncpg://evidentia:evidentia@localhost:5432/evidentia

# ─── Redis ───
REDIS_URL=redis://localhost:6379/0

# ─── LLM Provider (BYO-API) ───
# Supported: openai, anthropic, local
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# ─── Tool API Keys (BYO-API) ───
SERPAPI_KEY=
SEMANTIC_SCHOLAR_API_KEY=
NCBI_API_KEY=
OPENALEX_EMAIL=

# ─── Security ───
# Generate a secret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=60
ALLOWED_ORIGINS=http://localhost:8000,http://localhost:3000

# ─── Workers ───
EVIDENTIA_WORKERS=4

# ─── Object Storage ───
S3_BUCKET=evidentia-docs
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=
S3_SECRET_KEY=
